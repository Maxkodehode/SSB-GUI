<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SSB_GUI.Models"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        x:Class="SSB_GUI.MainWindow"
        Title="SSB Data Explorer" Width="1200" Height="720">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="#0D808080" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Vertical" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Language" FontSize="11" Foreground="Gray" FontWeight="Medium" />
                        <ComboBox x:Name="LanguageComboBox"
                                  SelectedIndex="0"
                                  SelectionChanged="OnLanguageSelectionChanged"
                                  Width="110">
                            <ComboBoxItem Content="Norsk" Tag="no" />
                            <ComboBoxItem Content="English" Tag="en" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="3">
                        <TextBlock Text="Table of Contents (Search &amp; Fetch New)" FontSize="11" Foreground="Gray" FontWeight="Medium" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <AutoCompleteBox x:Name="TableSearchBox"
                                             Width="360"
                                             Watermark="Search table by name or ID..."
                                             ValueMemberBinding="{Binding Label}"
                                             SelectionChanged="OnTableSearchSelectionChanged">
                                <AutoCompleteBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:SsbTableInfo">
                                        <StackPanel Margin="2,4" Spacing="2">
                                            <TextBlock Text="{Binding Label}" FontWeight="Medium" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Id}" FontSize="11" Foreground="Gray" />
                                        </StackPanel>
                                    </DataTemplate>
                                </AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>

                            <Button x:Name="FetchMetadataButton"
                                    Content="Fetch Metadata"
                                    IsEnabled="False"
                                    Click="OnFetchMetadataClicked" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="3">
                        <TextBlock Text="Collected Metadata Files" FontSize="11" Foreground="Gray" FontWeight="Medium" />
                        <ComboBox x:Name="MetadataComboBox"
                                  Width="340"
                                  MaxDropDownHeight="350"
                                  PlaceholderText="Select collected metadata..."
                                  SelectionChanged="OnMetadataSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:SsbCachedMetadataItem">
                                    <StackPanel Margin="2,3" Spacing="1" MaxWidth="320">
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TableId}" FontSize="11" Foreground="Gray" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="3" VerticalAlignment="Bottom">
                        <Button x:Name="FetchButton"
                                Content="Fetch Data"
                                IsEnabled="False"
                                Click="OnFetchDataClicked" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Dynamic Parameter Section (Created per variable from metadata) -->
        <Border x:Name="ParametersSection"
                DockPanel.Dock="Top" 
                Background="#1A808080" 
                CornerRadius="6" 
                Padding="12" 
                Margin="0,0,0,12">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Query Parameters (from Metadata)" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="ParametersStatusSummary" 
                                   Text="" 
                                   Foreground="Gray" 
                                   FontSize="11" 
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Collapse / Expand Toggle Button -->
                    <Button x:Name="ToggleParametersButton"
                            Grid.Column="1"
                            Content="▲ Hide Parameters"
                            FontSize="11"
                            Padding="8,4"
                            Click="OnToggleParametersClicked" />
                </Grid>

                <!-- Collapsible container for parameters -->
                <ScrollViewer x:Name="ParametersContent" 
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="DynamicParametersPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Visualization Options & Chart Area -->
        <Border Background="#0D808080" CornerRadius="8" Padding="14">
            <DockPanel>
                <!-- Top Toolbar: Title & Eligible Data Visualizations Selector (always outside collapsed parameters) -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Visualization:" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" Foreground="Gray" />
                        <ComboBox x:Name="VisualizationTypeComboBox"
                                  SelectedIndex="0"
                                  Width="140"
                                  SelectionChanged="OnVisualizationTypeChanged">
                            <ComboBoxItem Content="Line Chart" Tag="Line" />
                            <ComboBoxItem Content="Column Chart" Tag="Column" />
                            <ComboBoxItem Content="Area Chart" Tag="Area" />
                            <ComboBoxItem Content="Step Line Chart" Tag="StepLine" />
                            <ComboBoxItem Content="Pie Chart" Tag="Pie" />
                        </ComboBox>
                    </StackPanel>

                    <TextBlock x:Name="ChartTitleTextBlock" 
                               FontWeight="SemiBold"
                               FontSize="14"
                               VerticalAlignment="Center"
                               IsVisible="False"
                               TextWrapping="Wrap" />
                </DockPanel>

                <!-- Chart Canvas and Placeholder -->
                <Grid>
                    <TextBlock x:Name="ChartPlaceholder"
                               Text="Select a metadata file and query parameters above, then click 'Fetch Data' to display the graph." 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Foreground="Gray"
                               FontSize="15" />

                    <!-- Cartesian Chart (Line, Bar/Column, Area, StepLine) -->
                    <lvc:CartesianChart x:Name="ChartControl"
                                        IsVisible="False"
                                        MinHeight="380" />

                    <!-- Pie Chart (for eligible categorical/proportional datasets) -->
                    <lvc:PieChart x:Name="PieChartControl"
                                  IsVisible="False"
                                  MinHeight="380" />
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>